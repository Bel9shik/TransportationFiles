<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="kardash.project.app.core.cotrollers.FXMLControllers.ProgressController"
      alignment="CENTER" spacing="24" style="-fx-padding: 40;">
    <Label text="Приём файла" style="-fx-font-size: 26;"/>
    <ProgressBar fx:id="progressBar" prefWidth="500"/>
    <Label fx:id="statusLabel" wrapText="true" maxWidth="600"/>
    <Button text="В меню / отменить передачу" onAction="#handleBack"/>
</VBox>
