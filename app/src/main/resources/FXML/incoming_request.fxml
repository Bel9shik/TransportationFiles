<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="kardash.project.app.core.cotrollers.FXMLControllers.IncomingRequestController"
      alignment="CENTER" spacing="20" style="-fx-padding: 32; -fx-background-color: linear-gradient(to bottom, #8e44ad, #9b59b6);">
    <Label text="Входящий запрос" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
    <ImageView fitHeight="110" fitWidth="110" preserveRatio="true">
        <Image url="@../icons/alert.gif"/>
    </ImageView>
    <VBox alignment="CENTER" spacing="14" maxWidth="660"
          style="-fx-padding: 20; -fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 16;">
        <Label fx:id="senderLabel" wrapText="true" maxWidth="600" style="-fx-text-fill: white; -fx-font-size: 18;"/>
        <ScrollPane fitToWidth="true" maxHeight="140" style="-fx-background: transparent; -fx-background-color: transparent;">
        <Label fx:id="fileLabel" wrapText="true" maxWidth="600" style="-fx-text-fill: white; -fx-font-size: 16;"/>
        </ScrollPane>
        <Label fx:id="sizeLabel" style="-fx-text-fill: #dfe4ea; -fx-font-size: 14;"/>
        <Separator/>
        <Label fx:id="destinationLabel" wrapText="true" maxWidth="600" style="-fx-text-fill: white; -fx-font-size: 14;"/>
        <Label text="При совпадении имён к новому файлу добавится номер." wrapText="true" style="-fx-text-fill: #e9ddf1;"/>
    </VBox>
    <HBox alignment="CENTER" spacing="16">
        <Button fx:id="rejectBtn" text="Отклонить" onAction="#reject"
                style="-fx-background-radius: 16; -fx-font-size: 15; -fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 12 24;"/>
        <Button fx:id="saveAsBtn" text="Сохранить как…" onAction="#saveAs"
                style="-fx-background-radius: 16; -fx-font-size: 15; -fx-background-color: white; -fx-text-fill: #54346b; -fx-padding: 12 24;"/>
        <Button fx:id="acceptBtn" text="Принять" onAction="#accept"
                style="-fx-background-radius: 16; -fx-font-size: 15; -fx-background-color: #2ecc71; -fx-text-fill: white; -fx-padding: 12 24;"/>
    </HBox>
</VBox>
